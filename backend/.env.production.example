NODE_ENV=production
# Use the Supabase session pooler so hosts without IPv6 can connect.
# Final project ref: nftxvimumwvhjrmwtlfs (ap-northeast-1)
DATABASE_URL=postgresql://postgres.nftxvimumwvhjrmwtlfs:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=<at-least-32-random-characters>
REFRESH_TOKEN_SECRET=<different-at-least-32-random-characters>
PORT=4000
CORS_ORIGINS=<admin-and-client-origins>

SMS_PROVIDER=<real-provider>
PAYMENT_PROVIDER=<real-provider>
SAP_MODE=disabled
# Required before selecting SAP_MODE=service-layer. Values are supplied by the SAP team;
# do not invent or copy these into source control.
SAP_B1_BASE_URL=<sap-service-layer-https-url>
SAP_B1_COMPANY_DB=<sap-company-db>
SAP_B1_AUTH_MODE=<sap-auth-mode>
SAP_B1_USERNAME=<server-side-technical-user>
SAP_B1_PASSWORD=<server-side-technical-password>
SAP_B1_DEFAULT_WAREHOUSE=<sap-default-warehouse>
STORAGE_PROVIDER=s3
DISABLE_JOBS=false
RECOVERY_INTERVAL_MINUTES=60
REDIS_URL=<managed-redis-url>
OBJECT_STORAGE_ENDPOINT=<private-object-storage-endpoint>
OBJECT_STORAGE_REGION=<object-storage-region>
OBJECT_STORAGE_BUCKET=gagan-production
OBJECT_STORAGE_ACCESS_KEY=<secret>
OBJECT_STORAGE_SECRET_KEY=<secret>
SENTRY_DSN=<optional-production-dsn>
