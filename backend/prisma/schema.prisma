generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  active
  suspended
  revoked
}

enum RetailerLifecycle {
  pending_kyc
  active
  suspended
  closed
}

enum KycCaseStatus {
  draft
  submitted
  in_review
  approved
  rejected
}

enum KycDocumentType {
  business_registration
  identity_proof
  address_proof
  bank_proof
  other
}

enum KycDocumentStatus {
  uploaded
  accepted
  rejected
}

enum KycReviewDecision {
  approved
  rejected
  changes_requested
}

enum EvidencePurpose {
  kyc_document
  collection_receipt
  pod
}

enum RetailerSapAccountStatus {
  pending
  active
  blocked
}

enum IdentityRealm {
  retailer
  staff
  admin
}

enum OrderStatus {
  placed
  confirmed
  packed
  out_for_delivery
  delivered
  rejected
}

enum PlacedBy {
  retailer
  rep
}

enum LedgerType {
  invoice
  payment
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  reversed
}

enum PaymentChannel {
  /// Retailer paid in-app through a payment provider.
  online
  /// Ops recorded a cash/cheque/NEFT payment collected offline.
  manual
}

enum CollectionMethod {
  cash
  cheque
  neft
  upi
}

enum CollectionSubmissionStatus {
  pending
  confirming
  confirmed
  rejected
}

enum InvoiceStatus {
  open
  partially_paid
  paid
  voided
}

enum FinancialDirection {
  debit
  credit
}

enum FinancialLedgerKind {
  invoice
  payment
  credit_note
  payment_reversal
}

enum CreditNoteStatus {
  issued
  reversed
}

enum ReconciliationIssueStatus {
  open
  resolved
  ignored
}

enum CreditRating {
  N
  A
  B
  C
  D
  E
  F
}

enum BillingPattern {
  unknown
  regular
  irregular
}

enum CreditAssessmentResult {
  allowed
  approval_required
  blocked
}

enum ApprovalStatus {
  open
  escalated
  approved
  rejected
  cancelled
}

enum ApprovalDecisionResult {
  approved
  rejected
}

enum ApprovalDisputeStatus {
  open
  resolved
  escalated
}

enum DispatchAuthorizationStatus {
  active
  used
  invalidated
  expired
}

enum RatingProposalStatus {
  pending
  confirmed
  dismissed
}

enum CreditRolloutMode {
  shadow
  enforce
}

enum RecoveryCaseStatus {
  open
  resolved
  closed
}

enum RecoveryActionStatus {
  pending
  completed
  skipped
}

enum RecoveryActionType {
  day_35_sales_call
  day_40_joint_call
  days_45_48_collection_visit
  days_49_52_accounts_escalation
  days_53_56_credit_review
  days_60_69_hold_escalation
  days_70_89_legal_preparation
  day_90_legal_referral
}

model Payment {
  id                    String                @id @default(uuid())
  retailerId            String
  retailer              Retailer              @relation(fields: [retailerId], references: [id])
  amount                Decimal               @db.Decimal(12, 2)
  status                PaymentStatus         @default(pending)
  channel               PaymentChannel        @default(online)
  /// Which adapter handled it ("mock", "razorpay", …). Null for manual entries.
  provider              String?
  /// The provider's own id for this attempt — used to reconcile webhooks.
  providerRef           String?               @unique
  failureReason         String?
  unallocatedAmount     Decimal               @default(0) @db.Decimal(14, 2)
  ledgerEntries         LedgerEntry[]
  allocations           PaymentAllocation[]
  evidence              PaymentEvidence[]
  reversals             PaymentReversal[]
  settlementLedgerEntry FinancialLedgerEntry?
  collectionSubmission CollectionSubmission?
  createdAt             DateTime              @default(now())
  settledAt             DateTime?

  @@index([retailerId, status])
}

enum PodType {
  photo
  otp
  signature
}

model Tier {
  id              String      @id @default(uuid())
  name            String      @unique
  description     String?
  /// Default credit period in days; a retailer may override it.
  paymentTermDays Int         @default(15)
  retailers       Retailer[]
  priceList       PriceList[]
  createdAt       DateTime    @default(now())
}

model Retailer {
  id                        String                     @id @default(uuid())
  name                      String
  shopAddress               String
  phone                     String                     @unique
  status                    RetailerLifecycle          @default(pending_kyc)
  tierId                    String
  tier                      Tier                       @relation(fields: [tierId], references: [id])
  creditLimit               Decimal                    @default(0) @db.Decimal(12, 2)
  currentBalance            Decimal                    @default(0) @db.Decimal(12, 2)
  // Derived: recomputed from unsettled past-due invoices by recomputeOverdue().
  // Stored so list screens don't have to age every retailer's ledger on read.
  overdueAmount             Decimal                    @default(0) @db.Decimal(12, 2)
  /// Overrides the tier's payment term when set.
  paymentTermDays           Int?
  salesRepId                String?
  salesRep                  SalesRep?                  @relation(fields: [salesRepId], references: [id])
  sapCustomerId             String?
  orders                    Order[]
  ledgerEntries             LedgerEntry[]
  priceOverrides            PriceOverride[]
  notifications             Notification[]
  payments                  Payment[]
  collectionSubmissions     CollectionSubmission[]
  collectionAssignments     CollectionAssignment[]
  invoices                  Invoice[]
  financialLedgerEntries    FinancialLedgerEntry[]
  recoveryCases             RecoveryCase[]
  creditNotes               CreditNote[]
  reconciliationIssues      ReconciliationIssue[]
  creditProfile             CreditProfile?
  creditAssessments         CreditAssessment[]
  approvalRequests          ApprovalRequest[]
  creditDecisionComparisons CreditDecisionComparison[]
  kycCase                   KycCase?
  contacts                  RetailerContact[]
  sapAccounts               RetailerSapAccount[]
  createdAt                 DateTime                   @default(now())
}

model KycCase {
  id                 String         @id @default(uuid())
  retailerId         String         @unique
  retailer           Retailer       @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status             KycCaseStatus  @default(draft)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByStaffId  String?
  rejectionReason    String?
  documents          KycDocument[]
  reviews            KycReview[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, updatedAt])
}

model KycDocument {
  id                 String            @id @default(uuid())
  caseId             String
  kycCase            KycCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type               KycDocumentType
  assetId            String            @unique
  asset              EvidenceAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status             KycDocumentStatus @default(uploaded)
  uploadedByStaffId  String?
  rejectionReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([caseId, type, status])
}

model KycReview {
  id                String            @id @default(uuid())
  caseId            String
  kycCase           KycCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewerStaffId   String
  decision          KycReviewDecision
  reason            String
  createdAt         DateTime          @default(now())

  @@index([caseId, createdAt])
}

model EvidenceAsset {
  id              String          @id @default(uuid())
  objectKey       String          @unique
  checksum        String
  contentType     String
  sizeBytes       Int
  purpose         EvidencePurpose
  createdByStaffId String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?
  kycDocument     KycDocument?

  @@index([purpose, createdAt])
}

model RetailerContact {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([retailerId, isPrimary])
}

model RetailerSapAccount {
  id         String                   @id @default(uuid())
  retailerId String
  retailer   Retailer                 @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  cardCode   String
  status     RetailerSapAccountStatus @default(pending)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([retailerId, cardCode])
  @@index([cardCode, status])
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  staffUser    StaffUser?
  createdAt    DateTime   @default(now())
}

model SalesRep {
  id        String     @id @default(uuid())
  name      String
  phone     String
  photoUrl  String?
  retailers Retailer[]
  staffUser StaffUser?
}

model StaffUser {
  id               String           @id @default(uuid())
  name             String
  phone            String           @unique
  email            String           @unique
  employeeRef      String?          @unique
  status           StaffStatus      @default(active)
  salesRepId       String?          @unique
  salesRep         SalesRep?        @relation(fields: [salesRepId], references: [id])
  adminUserId      String?          @unique
  adminUser        AdminUser?       @relation(fields: [adminUserId], references: [id])
  roles            StaffRole[]
  delegationsGiven RoleDelegation[] @relation("Delegator")
  delegationsHeld  RoleDelegation[] @relation("Delegatee")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  staff       StaffRole[]
  permissions RolePermission[]
  delegations RoleDelegation[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model StaffRole {
  staffId    String
  roleId     String
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([staffId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleDelegation {
  id               String    @id @default(uuid())
  delegatorStaffId String
  delegateeStaffId String
  roleId           String
  delegator        StaffUser @relation("Delegator", fields: [delegatorStaffId], references: [id])
  delegatee        StaffUser @relation("Delegatee", fields: [delegateeStaffId], references: [id])
  role             Role      @relation(fields: [roleId], references: [id])
  startsAt         DateTime
  endsAt           DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([delegateeStaffId, startsAt, endsAt])
  @@index([delegatorStaffId])
  @@index([roleId])
}

model DeviceSession {
  id               String            @id @default(uuid())
  realm            IdentityRealm
  subjectId        String
  tokenFamilyId    String
  refreshTokenHash String            @unique
  deviceName       String?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime          @default(now())
  lastUsedAt       DateTime          @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  stepUpChallenges StepUpChallenge[]

  @@index([realm, subjectId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model OtpChallenge {
  id                String        @id @default(uuid())
  realm             IdentityRealm
  phone             String
  codeHash          String
  requestIpHash     String?
  attempts          Int           @default(0)
  maxAttempts       Int           @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([realm, phone, createdAt])
  @@index([expiresAt])
}

model StepUpChallenge {
  id         String        @id @default(uuid())
  sessionId  String
  session    DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int           @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([sessionId, expiresAt])
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorStaffId String?
  action       String
  subjectType  String
  subjectId    String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorStaffId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Read-only scheme display for v1 — the spec defers a real promotions engine.
// Progress is computed from delivered/placed order totals inside the window.
model Scheme {
  id             String   @id @default(uuid())
  name           String
  headline       String
  targetAmount   Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  startsAt       DateTime
  endsAt         DateTime
}

enum SapSyncStatus {
  idle
  running
  ok
  failed
}

enum SapEntity {
  customers
  materials
  pricing
  stock
}

/// Watermark per entity so each pull asks SAP only for what changed.
model SapSyncState {
  entity       SapEntity     @id
  lastSyncedAt DateTime?
  lastStatus   SapSyncStatus @default(idle)
  lastMessage  String?
  recordCount  Int           @default(0)
  updatedAt    DateTime      @updatedAt
}

enum SapOutboxKind {
  sales_order
  invoice
}

enum SapOutboxStatus {
  pending
  sent
  failed
}

/// Outbound queue for things we owe SAP. Orders and invoices are recorded here
/// the moment they happen, so nothing is lost while SAP is unreachable or not
/// yet configured — the drain job retries later.
model SapOutbox {
  id          String          @id @default(uuid())
  kind        SapOutboxKind
  /// Order.id or LedgerEntry.id depending on kind.
  referenceId String
  payload     Json
  status      SapOutboxStatus @default(pending)
  attempts    Int             @default(0)
  lastError   String?
  /// SAP's id once accepted (sales order or invoice number).
  sapId       String?
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@unique([kind, referenceId])
  @@index([status, createdAt])
}

model AppConfig {
  id                            String            @id @default("singleton")
  freeDeliveryThreshold         Decimal           @db.Decimal(12, 2)
  minOrderValue                 Decimal           @db.Decimal(12, 2)
  supportPhone                  String
  creditRolloutMode             CreditRolloutMode @default(shadow)
  creditPolicyApprovedAt        DateTime?
  creditPolicyApprovedByStaffId String?
  creditPolicyApprovedVersion   Int?
}

model Product {
  id            String    @id @default(uuid())
  name          String
  category      String
  imageUrl      String?
  sapMaterialId String?
  variants      Variant[]
  createdAt     DateTime  @default(now())
}

// A variant is one sellable case: `unitSize` x `unitsPerCase` (e.g. "1 kg" x 30).
// PriceList.price is the price of the whole case.
model Variant {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  unitSize       String
  unit           String
  unitsPerCase   Int             @default(1)
  // Numeric weight of a single unit. Needed to invoice off delivered weight
  // (spec §5.6): price/kg = casePrice / (unitWeightKg * unitsPerCase).
  unitWeightKg   Decimal         @default(1) @db.Decimal(10, 3)
  priceList      PriceList[]
  orderItems     OrderItem[]
  priceOverrides PriceOverride[]
}

model PriceList {
  id        String  @id @default(uuid())
  tierId    String
  tier      Tier    @relation(fields: [tierId], references: [id])
  productId String
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  price     Decimal @db.Decimal(12, 2)

  @@unique([tierId, variantId])
}

model PriceOverride {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  price      Decimal  @db.Decimal(12, 2)

  @@unique([retailerId, variantId])
}

model Order {
  id                        String                     @id @default(uuid())
  // Human-facing reference shown to retailers (rendered as GGN-00001).
  orderNo                   Int                        @unique @default(autoincrement())
  retailerId                String
  retailer                  Retailer                   @relation(fields: [retailerId], references: [id])
  placedBy                  PlacedBy                   @default(retailer)
  placedByRepId             String?
  status                    OrderStatus                @default(placed)
  orderTotal                Decimal                    @db.Decimal(12, 2)
  expectedDeliveryAt        DateTime?
  sapSalesOrderId           String?
  items                     OrderItem[]
  delivery                  Delivery?
  invoice                   Invoice?
  ledgerEntries             LedgerEntry[]
  creditAssessments         CreditAssessment[]
  approvalRequests          ApprovalRequest[]
  dispatchAuthorizations    DispatchAuthorization[]
  creditDecisionComparisons CreditDecisionComparison[]
  createdAt                 DateTime                   @default(now())
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  variantId       String
  variant         Variant       @relation(fields: [variantId], references: [id])
  qtyOrdered      Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  qtyDelivered    Int?
  weightDelivered Decimal?      @db.Decimal(12, 3)
  invoiceLines    InvoiceLine[]
}

model Delivery {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  routeId       String?
  deliverySlot  DateTime?
  podType       PodType?
  podCapturedAt DateTime?
  actualWeight  Decimal?  @db.Decimal(12, 3)
}

model LedgerEntry {
  id               String     @id @default(uuid())
  retailerId       String
  retailer         Retailer   @relation(fields: [retailerId], references: [id])
  orderId          String?
  order            Order?     @relation(fields: [orderId], references: [id])
  paymentId        String?
  payment          Payment?   @relation(fields: [paymentId], references: [id])
  type             LedgerType
  amount           Decimal    @db.Decimal(12, 2)
  balanceAfter     Decimal    @db.Decimal(12, 2)
  // Invoices only: when payment falls due, and how much of it has been settled
  // by payments so far. An invoice is overdue when dueDate has passed and
  // settledAmount is still short of amount.
  dueDate          DateTime?
  settledAmount    Decimal    @default(0) @db.Decimal(12, 2)
  financialInvoice Invoice?
  createdAt        DateTime   @default(now())

  @@index([retailerId, type, dueDate])
}

model Invoice {
  id                  String                @id @default(uuid())
  invoiceNumber       Int                   @unique @default(autoincrement())
  retailerId          String
  retailer            Retailer              @relation(fields: [retailerId], references: [id])
  orderId             String?               @unique
  order               Order?                @relation(fields: [orderId], references: [id])
  legacyLedgerEntryId String?               @unique
  legacyLedgerEntry   LedgerEntry?          @relation(fields: [legacyLedgerEntryId], references: [id], onDelete: Restrict)
  invoiceDate         DateTime
  dueDate             DateTime
  currency            String                @default("INR")
  subtotal            Decimal               @db.Decimal(14, 2)
  taxTotal            Decimal               @default(0) @db.Decimal(14, 2)
  total               Decimal               @db.Decimal(14, 2)
  outstandingAmount   Decimal               @db.Decimal(14, 2)
  status              InvoiceStatus         @default(open)
  idempotencyKey      String                @unique
  sapInvoiceId        String?               @unique
  lines               InvoiceLine[]
  allocations         PaymentAllocation[]
  ledgerEntry         FinancialLedgerEntry?
  creditNotes         CreditNote[]
  recoveryCase        RecoveryCase?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([retailerId, status, dueDate])
}

/// One operational recovery timeline per overdue invoice. Actions are immutable
/// schedule keys so rerunning the worker cannot duplicate calls or escalations.
model RecoveryCase {
  id          String             @id @default(uuid())
  invoiceId   String             @unique
  invoice     Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  retailerId  String
  retailer    Retailer           @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status      RecoveryCaseStatus @default(open)
  openedAt    DateTime           @default(now())
  resolvedAt  DateTime?
  closedAt    DateTime?
  actions     RecoveryAction[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, updatedAt])
  @@index([retailerId, status])
}

model RecoveryAction {
  id                String               @id @default(uuid())
  caseId            String
  recoveryCase      RecoveryCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              RecoveryActionType
  status            RecoveryActionStatus @default(pending)
  dueAt             DateTime
  role              String
  assigneeStaffId   String?
  idempotencyKey    String               @unique
  details           Json?
  completedAt       DateTime?
  completedByStaffId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, dueAt])
  @@index([caseId, type])
}

model InvoiceLine {
  id                  String     @id @default(uuid())
  invoiceId           String
  invoice             Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderItemId         String?
  orderItem           OrderItem? @relation(fields: [orderItemId], references: [id])
  descriptionSnapshot String
  itemCodeSnapshot    String?
  deliveredCases      Int?
  deliveredWeightKg   Decimal?   @db.Decimal(14, 3)
  unitPrice           Decimal    @db.Decimal(14, 2)
  lineTotal           Decimal    @db.Decimal(14, 2)
  createdAt           DateTime   @default(now())

  @@unique([invoiceId, orderItemId])
}

model PaymentAllocation {
  id        String                      @id @default(uuid())
  paymentId String
  payment   Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice                     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal                     @db.Decimal(14, 2)
  reversals PaymentReversalAllocation[]
  createdAt DateTime                    @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId, createdAt])
}

model FinancialLedgerEntry {
  id                String              @id @default(uuid())
  sequence          BigInt              @unique @default(autoincrement())
  retailerId        String
  retailer          Retailer            @relation(fields: [retailerId], references: [id])
  invoiceId         String?             @unique
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId         String?             @unique
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNoteId      String?             @unique
  creditNote        CreditNote?         @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  paymentReversalId String?             @unique
  paymentReversal   PaymentReversal?    @relation(fields: [paymentReversalId], references: [id], onDelete: Restrict)
  direction         FinancialDirection
  kind              FinancialLedgerKind
  amount            Decimal             @db.Decimal(14, 2)
  balanceAfter      Decimal             @db.Decimal(14, 2)
  idempotencyKey    String              @unique
  occurredAt        DateTime
  metadata          Json?
  createdAt         DateTime            @default(now())

  @@index([retailerId, sequence])
}

model PaymentEvidence {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  objectKey   String   @unique
  checksum    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([paymentId, createdAt])
}

/// A field-collected payment remains outside the financial ledger until Accounts
/// verifies the evidence and confirms it. Collectors never create Payment rows.
model CollectionSubmission {
  id                String                    @id @default(uuid())
  retailerId        String
  retailer          Retailer                  @relation(fields: [retailerId], references: [id])
  collectorStaffId  String
  amount            Decimal                   @db.Decimal(12, 2)
  method            CollectionMethod
  reference         String?
  notes             String?
  idempotencyKey    String                    @unique
  status            CollectionSubmissionStatus @default(pending)
  rejectionReason   String?
  paymentId         String?                   @unique
  payment           Payment?                  @relation(fields: [paymentId], references: [id])
  confirmedByStaffId String?
  submittedAt      DateTime                  @default(now())
  confirmedAt       DateTime?
  updatedAt         DateTime                  @updatedAt
  evidence          CollectionEvidence[]

  @@index([status, submittedAt])
  @@index([retailerId, submittedAt])
  @@index([collectorStaffId, submittedAt])
}

model CollectionAssignment {
  id               String   @id @default(uuid())
  collectorStaffId String
  retailerId       String
  retailer         Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  active           Boolean  @default(true)
  assignedAt       DateTime @default(now())
  endedAt          DateTime?

  @@unique([collectorStaffId, retailerId])
  @@index([collectorStaffId, active, assignedAt])
}

model CollectionEvidence {
  id           String              @id @default(uuid())
  submissionId String
  submission   CollectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  objectKey    String              @unique
  checksum     String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime            @default(now())

  @@index([submissionId, createdAt])
}

model CreditNote {
  id              String                @id @default(uuid())
  retailerId      String
  retailer        Retailer              @relation(fields: [retailerId], references: [id])
  invoiceId       String
  invoice         Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount          Decimal               @db.Decimal(14, 2)
  reason          String
  status          CreditNoteStatus      @default(issued)
  idempotencyKey  String                @unique
  sapCreditNoteId String?               @unique
  ledgerEntry     FinancialLedgerEntry?
  createdAt       DateTime              @default(now())

  @@index([invoiceId, createdAt])
}

model PaymentReversal {
  id                  String                      @id @default(uuid())
  paymentId           String
  payment             Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount              Decimal                     @db.Decimal(14, 2)
  unallocatedAmount   Decimal                     @default(0) @db.Decimal(14, 2)
  reason              String
  idempotencyKey      String                      @unique
  allocationReversals PaymentReversalAllocation[]
  ledgerEntry         FinancialLedgerEntry?
  createdAt           DateTime                    @default(now())

  @@index([paymentId, createdAt])
}

model PaymentReversalAllocation {
  id                  String            @id @default(uuid())
  paymentReversalId   String
  paymentReversal     PaymentReversal   @relation(fields: [paymentReversalId], references: [id], onDelete: Restrict)
  paymentAllocationId String
  paymentAllocation   PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)
  amount              Decimal           @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())

  @@unique([paymentReversalId, paymentAllocationId])
  @@index([paymentAllocationId, createdAt])
}

model ReconciliationIssue {
  id             String                    @id @default(uuid())
  retailerId     String?
  retailer       Retailer?                 @relation(fields: [retailerId], references: [id])
  kind           String
  referenceType  String
  referenceId    String
  expectedAmount Decimal?                  @db.Decimal(14, 2)
  actualAmount   Decimal?                  @db.Decimal(14, 2)
  status         ReconciliationIssueStatus @default(open)
  ownerRole      String                    @default("accounts")
  details        Json?
  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?

  @@unique([kind, referenceType, referenceId])
  @@index([status, createdAt])
}

model CreditPolicyVersion {
  id                String             @id @default(uuid())
  version           Int                @unique
  name              String
  active            Boolean            @default(false)
  rules             Json
  reasonCatalog     Json
  approvedByStaffId String?
  approvedAt        DateTime?
  assessments       CreditAssessment[]
  ratingProposals   RatingProposal[]
  createdAt         DateTime           @default(now())

  @@index([active])
}

model CreditProfile {
  id                 String           @id @default(uuid())
  retailerId         String           @unique
  retailer           Retailer         @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  rating             CreditRating     @default(N)
  billingPattern     BillingPattern   @default(unknown)
  accountCreatedAt   DateTime         @default(now())
  kycVerifiedAt      DateTime?
  kycVerifiedByStaffId String?
  kycEvidence        Json?
  ratingConfirmedAt  DateTime?
  nextReviewAt       DateTime?
  cleanInvoiceCount  Int              @default(0)
  advancePaymentOnly Boolean          @default(false)
  lockedAt           DateTime?
  lockReason         String?
  ratingHistory      RatingHistory[]
  ratingProposals    RatingProposal[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model RatingProposal {
  id                 String               @id @default(uuid())
  creditProfileId    String
  creditProfile      CreditProfile        @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  policyVersionId    String
  policyVersion      CreditPolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  previousRating     CreditRating
  proposedRating     CreditRating
  trigger            String
  evidence           Json
  status             RatingProposalStatus @default(pending)
  idempotencyKey     String               @unique
  proposedAt         DateTime             @default(now())
  confirmedByStaffId String?
  confirmedAt        DateTime?
  dismissedByStaffId String?
  dismissedAt        DateTime?

  @@index([status, proposedAt])
  @@index([creditProfileId, proposedAt])
}

model RatingHistory {
  id                 String         @id @default(uuid())
  sequence           BigInt         @unique @default(autoincrement())
  creditProfileId    String
  creditProfile      CreditProfile  @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  fromRating         CreditRating?
  toRating           CreditRating
  billingPattern     BillingPattern
  reason             String
  evidence           Json
  confirmedByStaffId String
  effectiveAt        DateTime
  createdAt          DateTime       @default(now())

  @@index([creditProfileId, sequence])
}

model CreditAssessment {
  id                     String                    @id @default(uuid())
  retailerId             String
  retailer               Retailer                  @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId                String?
  order                  Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  policyVersionId        String
  policyVersion          CreditPolicyVersion       @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  result                 CreditAssessmentResult
  requiredPermission     String?
  projectedExposure      Decimal                   @db.Decimal(14, 2)
  snapshot               Json
  reasons                Json
  approvalRequests       ApprovalRequest[]
  dispatchAuthorizations DispatchAuthorization[]
  comparison             CreditDecisionComparison?
  createdAt              DateTime                  @default(now())

  @@index([retailerId, createdAt])
  @@index([orderId, createdAt])
}

model CreditDecisionComparison {
  id                    String                 @id @default(uuid())
  retailerId            String
  retailer              Retailer               @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId               String?
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assessmentId          String                 @unique
  assessment            CreditAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  rolloutMode           CreditRolloutMode
  legacyResult          String
  engineResult          CreditAssessmentResult
  effectiveResult       String
  mismatch              Boolean
  creditTeamDisposition String?
  createdAt             DateTime               @default(now())

  @@index([mismatch, createdAt])
  @@index([retailerId, createdAt])
}

model ApprovalRequest {
  id                     String                  @id @default(uuid())
  retailerId             String
  retailer               Retailer                @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId                String?
  order                  Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assessmentId           String
  assessment             CreditAssessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  subjectType            String
  subjectId              String
  approvalType           String
  requiredPermission     String
  status                 ApprovalStatus          @default(open)
  requestedByStaffId     String?
  requestReason          String?
  deadlineAt             DateTime?
  acknowledgedAt         DateTime?
  decidedAt              DateTime?
  escalatedAt            DateTime?
  decision               ApprovalDecision?
  escalations            ApprovalEscalation[]
  disputes               ApprovalDispute[]
  dispatchAuthorizations DispatchAuthorization[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([requiredPermission, status, createdAt])
  @@index([retailerId, createdAt])
}

model ApprovalDecision {
  id                String                 @id @default(uuid())
  approvalRequestId String                 @unique
  approvalRequest   ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  result            ApprovalDecisionResult
  actorStaffId      String
  reason            String?
  stepUpSessionId   String
  createdAt         DateTime               @default(now())
}

model ApprovalEscalation {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  fromPermission    String
  toPermission      String
  reasonCode        String
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId, createdAt])
}

model ApprovalDispute {
  id                  String                @id @default(uuid())
  approvalRequestId   String
  approvalRequest     ApprovalRequest       @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  status              ApprovalDisputeStatus @default(open)
  raisedByStaffId     String
  writtenPosition     String
  counterPosition     String?
  resolvedByStaffId   String?
  resolution          String?
  outcome             ApprovalDecisionResult?
  acknowledgmentDueAt DateTime
  acknowledgedAt      DateTime?
  decisionDueAt       DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status, acknowledgmentDueAt])
  @@index([approvalRequestId, createdAt])
}

model DispatchAuthorization {
  id                String                      @id @default(uuid())
  orderId           String
  order             Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version           Int
  assessmentId      String
  assessment        CreditAssessment            @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  approvalRequestId String?
  approvalRequest   ApprovalRequest?            @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  status            DispatchAuthorizationStatus @default(active)
  issuedByStaffId   String?
  reason            String
  expiresAt         DateTime?
  usedAt            DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime                    @default(now())

  @@unique([orderId, version])
  @@index([orderId, status])
}

model WorkingCalendar {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  isWorkingDay Boolean
  label        String?
  createdAt    DateTime @default(now())
}
