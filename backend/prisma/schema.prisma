generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  placed
  confirmed
  packed
  out_for_delivery
  delivered
  rejected
}

enum PlacedBy {
  retailer
  rep
}

enum LedgerType {
  invoice
  payment
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
}

enum PaymentChannel {
  /// Retailer paid in-app through a payment provider.
  online
  /// Ops recorded a cash/cheque/NEFT payment collected offline.
  manual
}

model Payment {
  id          String         @id @default(uuid())
  retailerId  String
  retailer    Retailer       @relation(fields: [retailerId], references: [id])
  amount      Decimal        @db.Decimal(12, 2)
  status      PaymentStatus  @default(pending)
  channel     PaymentChannel @default(online)
  /// Which adapter handled it ("mock", "razorpay", …). Null for manual entries.
  provider    String?
  /// The provider's own id for this attempt — used to reconcile webhooks.
  providerRef String?        @unique
  failureReason String?
  ledgerEntries LedgerEntry[]
  createdAt   DateTime       @default(now())
  settledAt   DateTime?

  @@index([retailerId, status])
}

enum PodType {
  photo
  otp
  signature
}

model Tier {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  /// Default credit period in days; a retailer may override it.
  paymentTermDays Int      @default(15)
  retailers   Retailer[]
  priceList   PriceList[]
  createdAt   DateTime     @default(now())
}

model Retailer {
  id             String        @id @default(uuid())
  name           String
  shopAddress    String
  phone          String        @unique
  tierId         String
  tier           Tier          @relation(fields: [tierId], references: [id])
  creditLimit    Decimal       @default(0) @db.Decimal(12, 2)
  currentBalance Decimal       @default(0) @db.Decimal(12, 2)
  // Derived: recomputed from unsettled past-due invoices by recomputeOverdue().
  // Stored so list screens don't have to age every retailer's ledger on read.
  overdueAmount  Decimal       @default(0) @db.Decimal(12, 2)
  /// Overrides the tier's payment term when set.
  paymentTermDays Int?
  salesRepId     String?
  salesRep       SalesRep?     @relation(fields: [salesRepId], references: [id])
  sapCustomerId  String?
  orders         Order[]
  ledgerEntries  LedgerEntry[]
  priceOverrides PriceOverride[]
  notifications  Notification[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model SalesRep {
  id        String     @id @default(uuid())
  name      String
  phone     String
  photoUrl  String?
  retailers Retailer[]
}

model Notification {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Read-only scheme display for v1 — the spec defers a real promotions engine.
// Progress is computed from delivered/placed order totals inside the window.
model Scheme {
  id             String   @id @default(uuid())
  name           String
  headline       String
  targetAmount   Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  startsAt       DateTime
  endsAt         DateTime
}

enum SapSyncStatus {
  idle
  running
  ok
  failed
}

enum SapEntity {
  customers
  materials
  pricing
  stock
}

/// Watermark per entity so each pull asks SAP only for what changed.
model SapSyncState {
  entity       SapEntity     @id
  lastSyncedAt DateTime?
  lastStatus   SapSyncStatus @default(idle)
  lastMessage  String?
  recordCount  Int           @default(0)
  updatedAt    DateTime      @updatedAt
}

enum SapOutboxKind {
  sales_order
  invoice
}

enum SapOutboxStatus {
  pending
  sent
  failed
}

/// Outbound queue for things we owe SAP. Orders and invoices are recorded here
/// the moment they happen, so nothing is lost while SAP is unreachable or not
/// yet configured — the drain job retries later.
model SapOutbox {
  id          String          @id @default(uuid())
  kind        SapOutboxKind
  /// Order.id or LedgerEntry.id depending on kind.
  referenceId String
  payload     Json
  status      SapOutboxStatus @default(pending)
  attempts    Int             @default(0)
  lastError   String?
  /// SAP's id once accepted (sales order or invoice number).
  sapId       String?
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@unique([kind, referenceId])
  @@index([status, createdAt])
}

model AppConfig {
  id                    String  @id @default("singleton")
  freeDeliveryThreshold Decimal @db.Decimal(12, 2)
  minOrderValue         Decimal @db.Decimal(12, 2)
  supportPhone          String
}

model Product {
  id            String     @id @default(uuid())
  name          String
  category      String
  imageUrl      String?
  sapMaterialId String?
  variants      Variant[]
  createdAt     DateTime   @default(now())
}

// A variant is one sellable case: `unitSize` x `unitsPerCase` (e.g. "1 kg" x 30).
// PriceList.price is the price of the whole case.
model Variant {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  unitSize     String
  unit         String
  unitsPerCase Int         @default(1)
  // Numeric weight of a single unit. Needed to invoice off delivered weight
  // (spec §5.6): price/kg = casePrice / (unitWeightKg * unitsPerCase).
  unitWeightKg Decimal     @default(1) @db.Decimal(10, 3)
  priceList    PriceList[]
  orderItems   OrderItem[]
  priceOverrides PriceOverride[]
}

model PriceList {
  id        String  @id @default(uuid())
  tierId    String
  tier      Tier    @relation(fields: [tierId], references: [id])
  productId String
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  price     Decimal @db.Decimal(12, 2)

  @@unique([tierId, variantId])
}

model PriceOverride {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  price      Decimal  @db.Decimal(12, 2)

  @@unique([retailerId, variantId])
}

model Order {
  id             String        @id @default(uuid())
  // Human-facing reference shown to retailers (rendered as GGN-00001).
  orderNo        Int           @unique @default(autoincrement())
  retailerId     String
  retailer       Retailer      @relation(fields: [retailerId], references: [id])
  placedBy       PlacedBy      @default(retailer)
  placedByRepId  String?
  status         OrderStatus   @default(placed)
  orderTotal     Decimal       @db.Decimal(12, 2)
  expectedDeliveryAt DateTime?
  sapSalesOrderId String?
  items          OrderItem[]
  delivery       Delivery?
  ledgerEntries  LedgerEntry[]
  createdAt      DateTime      @default(now())
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  variantId     String
  variant       Variant  @relation(fields: [variantId], references: [id])
  qtyOrdered    Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  qtyDelivered  Int?
  weightDelivered Decimal? @db.Decimal(12, 3)
}

model Delivery {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  routeId        String?
  deliverySlot   DateTime?
  podType        PodType?
  podCapturedAt  DateTime?
  actualWeight   Decimal?  @db.Decimal(12, 3)
}

model LedgerEntry {
  id          String     @id @default(uuid())
  retailerId  String
  retailer    Retailer   @relation(fields: [retailerId], references: [id])
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id])
  paymentId   String?
  payment     Payment?   @relation(fields: [paymentId], references: [id])
  type        LedgerType
  amount      Decimal    @db.Decimal(12, 2)
  balanceAfter Decimal   @db.Decimal(12, 2)
  // Invoices only: when payment falls due, and how much of it has been settled
  // by payments so far. An invoice is overdue when dueDate has passed and
  // settledAmount is still short of amount.
  dueDate       DateTime?
  settledAmount Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  @@index([retailerId, type, dueDate])
}
