{
  "name": "gagan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "financial:backfill": "ts-node --transpile-only scripts/backfillFinancialCore.ts",
    "financial:reconcile": "ts-node --transpile-only scripts/reconcileFinancialCore.ts",
    "check:sales-org-readiness": "ts-node --transpile-only scripts/checkSalesOrgReadiness.ts",
    "seed:staging-hierarchy": "ts-node --transpile-only scripts/seedStagingHierarchy.ts",
    "seed:field-uat": "ts-node --transpile-only scripts/seedFieldUat.ts",
    "seed:founder-uat": "ts-node --transpile-only scripts/seedFounderUat.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.19.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
