NODE_ENV=staging
# Render injects this from the isolated gagan-staging-db service.
DATABASE_URL=postgresql://<render-user>:<render-password>@<render-host>:5432/gagan_staging
JWT_SECRET=<fresh-staging-secret-at-least-32-characters>
REFRESH_TOKEN_SECRET=<different-fresh-staging-secret-at-least-32-characters>
PORT=10000
CORS_ORIGINS=https://gagan-staging-admin.vercel.app

# Staging deliberately uses test adapters; no real SAP, SMS, or payments.
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
SAP_MODE=mock
MOCK_OTP=123456
MOCK_PAYMENT_SECRET=<fresh-staging-payment-secret>

# Evidence is not part of the client smoke path. Use a staging-only ephemeral
# directory until a private object store is required for the real rollout.
STORAGE_PROVIDER=local
OBJECT_STORAGE_ROOT=.data/evidence
DISABLE_JOBS=false
# Render free tier has no background-worker service. Staging runs the single
# scheduler set inside the API process; keep this false outside staging.
STAGING_RUN_JOBS_IN_API=true
AGEING_INTERVAL_MINUTES=60
RECOVERY_INTERVAL_MINUTES=60
SAP_SYNC_INTERVAL_MINUTES=30
SAP_OUTBOX_INTERVAL_MINUTES=5
STORE_LOCATION_MAX_ACCURACY_METERS=50
VISIT_VERIFIED_RADIUS_METERS=150
VISIT_REVIEW_RADIUS_METERS=500
LOGISTICS_SERVICE_TOKEN=<fresh-staging-logistics-token>
