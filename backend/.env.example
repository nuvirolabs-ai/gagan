NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/gagan_dev
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Development adapters. Production configuration rejects any "mock" value.
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
SAP_MODE=disabled
# Leave these unset until the SAP team supplies the B1 contract.
# SAP_B1_BASE_URL=
# SAP_B1_COMPANY_DB=
# SAP_B1_AUTH_MODE=
# SAP_B1_USERNAME=
# SAP_B1_PASSWORD=
# SAP_B1_DEFAULT_WAREHOUSE=
STORAGE_PROVIDER=local
OBJECT_STORAGE_ROOT=.data/evidence

MOCK_OTP=123456
MOCK_PAYMENT_SECRET=replace-for-local-development

DISABLE_JOBS=false
AGEING_INTERVAL_MINUTES=60
RECOVERY_INTERVAL_MINUTES=60
SAP_SYNC_INTERVAL_MINUTES=60
SAP_OUTBOX_INTERVAL_MINUTES=5

# Required as the worker and evidence modules are introduced by later plans.
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=gagan-development
OBJECT_STORAGE_ACCESS_KEY=local-development
OBJECT_STORAGE_SECRET_KEY=replace-for-local-development
STORE_LOCATION_MAX_ACCURACY_METERS=50
VISIT_VERIFIED_RADIUS_METERS=150
VISIT_REVIEW_RADIUS_METERS=500
LOGISTICS_SERVICE_TOKEN=replace-with-a-secret-for-internal-logistics
SENTRY_DSN=
