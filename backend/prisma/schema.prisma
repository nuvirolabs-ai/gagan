generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  active
  suspended
  revoked
}

enum RetailerLifecycle {
  pending_kyc
  active
  suspended
  closed
}

enum KycCaseStatus {
  draft
  submitted
  in_review
  approved
  rejected
}

enum KycDocumentType {
  business_registration
  identity_proof
  address_proof
  bank_proof
  other
}

enum KycDocumentStatus {
  uploaded
  accepted
  rejected
}

enum KycReviewDecision {
  approved
  rejected
  changes_requested
}

enum EvidencePurpose {
  kyc_document
  collection_receipt
  pod
}

enum RetailerSapAccountStatus {
  pending
  active
  blocked
}

enum IdentityRealm {
  retailer
  staff
  admin
}

enum OrderStatus {
  placed
  confirmed
  packed
  out_for_delivery
  delivered
  rejected
}

enum PlacedBy {
  retailer
  rep
}

enum LedgerType {
  invoice
  payment
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  reversed
}

enum PaymentChannel {
  /// Retailer paid in-app through a payment provider.
  online
  /// Ops recorded a cash/cheque/NEFT payment collected offline.
  manual
}

enum CollectionMethod {
  cash
  cheque
  neft
  upi
}

enum CollectionSubmissionStatus {
  pending
  confirming
  confirmed
  rejected
}

enum InvoiceStatus {
  open
  partially_paid
  paid
  voided
}

enum FinancialDirection {
  debit
  credit
}

enum FinancialLedgerKind {
  invoice
  payment
  credit_note
  payment_reversal
}

enum CreditNoteStatus {
  issued
  reversed
}

enum ReconciliationIssueStatus {
  open
  resolved
  ignored
}

enum CreditRating {
  N
  A
  B
  C
  D
  E
  F
}

enum BillingPattern {
  unknown
  regular
  irregular
}

enum CreditAssessmentResult {
  allowed
  approval_required
  blocked
}

enum ApprovalStatus {
  open
  escalated
  approved
  rejected
  cancelled
}

enum ApprovalDecisionResult {
  approved
  rejected
}

enum ApprovalDisputeStatus {
  open
  resolved
  escalated
}

enum DispatchAuthorizationStatus {
  active
  used
  invalidated
  expired
}

enum RatingProposalStatus {
  pending
  confirmed
  dismissed
}

enum CreditRolloutMode {
  shadow
  enforce
}

enum RecoveryCaseStatus {
  open
  resolved
  closed
}

enum RecoveryActionStatus {
  pending
  completed
  skipped
}

enum RecoveryActionType {
  day_35_sales_call
  day_40_joint_call
  days_45_48_collection_visit
  days_49_52_accounts_escalation
  days_53_56_credit_review
  days_60_69_hold_escalation
  days_70_89_legal_preparation
  day_90_legal_referral
}

enum PromiseToPayStatus {
  promised
  kept
  missed
  superseded
}

enum RecoveryCallOutcome {
  no_answer
  spoke_with_customer
  promise_made
  dispute_raised
  wrong_number
}

enum RecoveryLetterDeliveryChannel {
  manual
  whatsapp
  sms
  email
}

enum LocationStatus {
  NOT_SET
  CAPTURED
  VERIFIED
  NEEDS_REVIEW
}

enum LocationSource {
  RETAILER_ONBOARDING
  SALESPERSON_VISIT
  ADMIN_CORRECTION
  MIGRATION
}

enum LocationVerificationStatus {
  VERIFIED
  NEEDS_REVIEW
  OUTSIDE_STORE_AREA
  STORE_LOCATION_NOT_AVAILABLE
  LOW_GPS_ACCURACY
}

enum LegalCaseStatus {
  open
  settled
  written_off
  closed
}

enum LegalDecisionType {
  settlement
  write_off
}

model Payment {
  id                    String                @id @default(uuid())
  retailerId            String
  retailer              Retailer              @relation(fields: [retailerId], references: [id])
  amount                Decimal               @db.Decimal(12, 2)
  status                PaymentStatus         @default(pending)
  channel               PaymentChannel        @default(online)
  /// Which adapter handled it ("mock", "razorpay", …). Null for manual entries.
  provider              String?
  /// The provider's own id for this attempt — used to reconcile webhooks.
  providerRef           String?               @unique
  failureReason         String?
  unallocatedAmount     Decimal               @default(0) @db.Decimal(14, 2)
  ledgerEntries         LedgerEntry[]
  allocations           PaymentAllocation[]
  evidence              PaymentEvidence[]
  reversals             PaymentReversal[]
  settlementLedgerEntry FinancialLedgerEntry?
  collectionSubmission  CollectionSubmission?
  createdAt             DateTime              @default(now())
  settledAt             DateTime?

  @@index([retailerId, status])
}

enum PodType {
  photo
  otp
  signature
}

model Tier {
  id              String             @id @default(uuid())
  name            String             @unique
  description     String?
  /// Default credit period in days; a retailer may override it.
  paymentTermDays Int                @default(15)
  retailers       Retailer[]
  priceList       PriceList[]
  proposals       RetailerProposal[]
  createdAt       DateTime           @default(now())
}

model Retailer {
  id                        String                     @id @default(uuid())
  name                      String
  shopAddress               String
  phone                     String                     @unique
  status                    RetailerLifecycle          @default(pending_kyc)
  tierId                    String
  tier                      Tier                       @relation(fields: [tierId], references: [id])
  creditLimit               Decimal                    @default(0) @db.Decimal(12, 2)
  currentBalance            Decimal                    @default(0) @db.Decimal(12, 2)
  // Derived: recomputed from unsettled past-due invoices by recomputeOverdue().
  // Stored so list screens don't have to age every retailer's ledger on read.
  overdueAmount             Decimal                    @default(0) @db.Decimal(12, 2)
  /// Overrides the tier's payment term when set.
  paymentTermDays           Int?
  salesRepId                String?
  salesRep                  SalesRep?                  @relation(fields: [salesRepId], references: [id])
  sapCustomerId             String?
  orders                    Order[]
  ledgerEntries             LedgerEntry[]
  priceOverrides            PriceOverride[]
  notifications             Notification[]
  payments                  Payment[]
  collectionSubmissions     CollectionSubmission[]
  collectionAssignments     CollectionAssignment[]
  invoices                  Invoice[]
  financialLedgerEntries    FinancialLedgerEntry[]
  recoveryCases             RecoveryCase[]
  creditNotes               CreditNote[]
  reconciliationIssues      ReconciliationIssue[]
  creditProfile             CreditProfile?
  creditAssessments         CreditAssessment[]
  approvalRequests          ApprovalRequest[]
  creditDecisionComparisons CreditDecisionComparison[]
  kycCase                   KycCase?
  location                  RetailerLocation?
  locationHistory           RetailerLocationHistory[]
  visits                    SalesVisit[]
  routeStops                RoutePlanStop[]
  customerActivities        CustomerActivity[]
  proposal                  RetailerProposal?
  fieldTasks                FieldTask[]
  serviceIssues             ServiceIssue[]
  contacts                  RetailerContact[]
  sapAccounts               RetailerSapAccount[]
  createdAt                 DateTime                   @default(now())
}

model KycCase {
  id                String        @id @default(uuid())
  retailerId        String        @unique
  retailer          Retailer      @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status            KycCaseStatus @default(draft)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByStaffId String?
  rejectionReason   String?
  documents         KycDocument[]
  reviews           KycReview[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, updatedAt])
}

model KycDocument {
  id                String            @id @default(uuid())
  caseId            String
  kycCase           KycCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type              KycDocumentType
  assetId           String            @unique
  asset             EvidenceAsset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status            KycDocumentStatus @default(uploaded)
  uploadedByStaffId String?
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([caseId, type, status])
}

model KycReview {
  id              String            @id @default(uuid())
  caseId          String
  kycCase         KycCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewerStaffId String
  decision        KycReviewDecision
  reason          String
  createdAt       DateTime          @default(now())

  @@index([caseId, createdAt])
}

model EvidenceAsset {
  id               String          @id @default(uuid())
  objectKey        String          @unique
  checksum         String
  contentType      String
  sizeBytes        Int
  purpose          EvidencePurpose
  createdByStaffId String?
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?
  kycDocument      KycDocument?

  @@index([purpose, createdAt])
}

model RetailerContact {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([retailerId, isPrimary])
}

model RetailerSapAccount {
  id         String                   @id @default(uuid())
  retailerId String
  retailer   Retailer                 @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  cardCode   String
  status     RetailerSapAccountStatus @default(pending)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([retailerId, cardCode])
  @@index([cardCode, status])
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  staffUser    StaffUser?
  createdAt    DateTime   @default(now())
}

model SalesRep {
  id        String     @id @default(uuid())
  name      String
  phone     String
  photoUrl  String?
  territory String?
  retailers Retailer[]
  staffUser StaffUser?
}

model StaffUser {
  id          String      @id @default(uuid())
  name        String
  phone       String      @unique
  email       String      @unique
  employeeRef String?     @unique
  status      StaffStatus @default(active)

  // The reporting line. One nullable self-relation is the whole hierarchy:
  // null means top of the tree, depth is unbounded, and no job title appears
  // anywhere in the logic that reads it. SetNull rather than Cascade because
  // removing a manager must orphan their reports upward, never delete people.
  managerId     String?
  manager       StaffUser?  @relation("StaffReporting", fields: [managerId], references: [id], onDelete: SetNull)
  directReports StaffUser[] @relation("StaffReporting")

  salesRepId                 String?            @unique
  salesRep                   SalesRep?          @relation(fields: [salesRepId], references: [id])
  adminUserId                String?            @unique
  adminUser                  AdminUser?         @relation(fields: [adminUserId], references: [id])
  roles                      StaffRole[]
  salesVisits                SalesVisit[]       @relation("SalespersonVisits")
  delegationsGiven           RoleDelegation[]   @relation("Delegator")
  delegationsHeld            RoleDelegation[]   @relation("Delegatee")
  workdaySessions            WorkdaySession[]   @relation("SalespersonWorkdays")
  leaveRequests              LeaveRequest[]     @relation("SalespersonLeave")
  leaveDecisions             LeaveRequest[]     @relation("LeaveDecisions")
  routePlans                 RoutePlan[]        @relation("SalespersonRoutePlans")
  customerActivities         CustomerActivity[] @relation("SalespersonActivities")
  fieldTasksAssigned         FieldTask[]        @relation("FieldTasksAssigned")
  fieldTasksCreated          FieldTask[]        @relation("FieldTasksCreated")
  locationPings              LocationPing[]     @relation("SalespersonPings")
  fieldExpenses              FieldExpense[]     @relation("SalespersonExpenses")
  expenseDecisions           FieldExpense[]     @relation("ExpenseDecisions")
  serviceIssues              ServiceIssue[]     @relation("ServiceIssuesRaised")
  salesTargets               SalesTarget[]      @relation("SalespersonTargets")
  retailerProposalsSubmitted RetailerProposal[] @relation("RetailerProposalsSubmitted")
  retailerProposalsReviewed  RetailerProposal[] @relation("RetailerProposalsReviewed")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([status])
  @@index([managerId])
}

/// The single current store location. Coordinates are nullable for existing
/// retailers until a foreground capture is explicitly confirmed.
model RetailerLocation {
  id               String          @id @default(uuid())
  retailerId       String          @unique
  retailer         Retailer        @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  latitude         Decimal?        @db.Decimal(10, 7)
  longitude        Decimal?        @db.Decimal(10, 7)
  accuracyMeters   Decimal?        @db.Decimal(8, 2)
  devicePlatform   String?
  status           LocationStatus  @default(NOT_SET)
  source           LocationSource?
  capturedAt       DateTime?
  capturedByUserId String?
  verifiedAt       DateTime?
  verifiedByUserId String?
  locationVersion  Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, updatedAt])
}

/// Append-only snapshots of every captured or reviewed location state.
model RetailerLocationHistory {
  id               String         @id @default(uuid())
  retailerId       String
  retailer         Retailer       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  latitude         Decimal?       @db.Decimal(10, 7)
  longitude        Decimal?       @db.Decimal(10, 7)
  accuracyMeters   Decimal?       @db.Decimal(8, 2)
  devicePlatform   String?
  status           LocationStatus
  source           LocationSource
  capturedByUserId String?
  capturedAt       DateTime?
  verifiedByUserId String?
  verifiedAt       DateTime?
  version          Int
  reasonForChange  String?
  createdAt        DateTime       @default(now())

  @@index([retailerId, createdAt])
  @@index([retailerId, version])
}

model SalesVisit {
  id                       String                     @id @default(uuid())
  salespersonId            String
  salesperson              StaffUser                  @relation("SalespersonVisits", fields: [salespersonId], references: [id], onDelete: Restrict)
  retailerId               String
  retailer                 Retailer                   @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  checkInLatitude          Decimal                    @db.Decimal(10, 7)
  checkInLongitude         Decimal                    @db.Decimal(10, 7)
  checkInAccuracyMeters    Decimal                    @db.Decimal(8, 2)
  devicePlatform           String?
  storeLatitudeSnapshot    Decimal?                   @db.Decimal(10, 7)
  storeLongitudeSnapshot   Decimal?                   @db.Decimal(10, 7)
  distanceFromStoreMeters  Decimal?                   @db.Decimal(10, 2)
  verificationStatus       LocationVerificationStatus
  checkedInAt              DateTime                   @default(now())
  checkedOutLatitude       Decimal?                   @db.Decimal(10, 7)
  checkedOutLongitude      Decimal?                   @db.Decimal(10, 7)
  checkedOutAccuracyMeters Decimal?                   @db.Decimal(8, 2)
  checkedOutAt             DateTime?
  checkoutDistanceMeters   Decimal?                   @db.Decimal(10, 2)
  notes                    String?
  /// Why the salesperson came. Defaults to a plain sales call.
  purpose                  VisitPurpose               @default(sales_call)
  /// Recorded when the visit is closed out; null while the visit is open.
  outcome                  VisitOutcome?
  followUpAt               DateTime?
  /// Set when the visit fulfils a planned route stop, so a planned visit and
  /// the visit that happened are one record rather than two.
  routeStopId              String?
  routeStop                RoutePlanStop?             @relation(fields: [routeStopId], references: [id], onDelete: SetNull)
  activities               CustomerActivity[]
  serviceIssues            ServiceIssue[]
  source                   LocationSource             @default(SALESPERSON_VISIT)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([routeStopId])
  @@index([salespersonId, checkedInAt])
  @@index([retailerId, checkedInAt])
  @@index([verificationStatus, checkedInAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  staff       StaffRole[]
  permissions RolePermission[]
  delegations RoleDelegation[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model StaffRole {
  staffId    String
  roleId     String
  staff      StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([staffId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleDelegation {
  id               String    @id @default(uuid())
  delegatorStaffId String
  delegateeStaffId String
  roleId           String
  delegator        StaffUser @relation("Delegator", fields: [delegatorStaffId], references: [id])
  delegatee        StaffUser @relation("Delegatee", fields: [delegateeStaffId], references: [id])
  role             Role      @relation(fields: [roleId], references: [id])
  startsAt         DateTime
  endsAt           DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([delegateeStaffId, startsAt, endsAt])
  @@index([delegatorStaffId])
  @@index([roleId])
}

model DeviceSession {
  id               String            @id @default(uuid())
  realm            IdentityRealm
  subjectId        String
  tokenFamilyId    String
  refreshTokenHash String            @unique
  deviceName       String?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime          @default(now())
  lastUsedAt       DateTime          @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  stepUpChallenges StepUpChallenge[]

  @@index([realm, subjectId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model OtpChallenge {
  id                String        @id @default(uuid())
  realm             IdentityRealm
  phone             String
  codeHash          String
  requestIpHash     String?
  attempts          Int           @default(0)
  maxAttempts       Int           @default(5)
  expiresAt         DateTime
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([realm, phone, createdAt])
  @@index([expiresAt])
}

model StepUpChallenge {
  id         String        @id @default(uuid())
  sessionId  String
  session    DeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int           @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([sessionId, expiresAt])
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorStaffId String?
  action       String
  subjectType  String
  subjectId    String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorStaffId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Read-only scheme display for v1 — the spec defers a real promotions engine.
// Progress is computed from delivered/placed order totals inside the window.
model Scheme {
  id             String   @id @default(uuid())
  name           String
  headline       String
  targetAmount   Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  startsAt       DateTime
  endsAt         DateTime
}

enum SapSyncStatus {
  idle
  running
  ok
  failed
}

enum SapEntity {
  customers
  materials
  pricing
  stock
}

/// Watermark per entity so each pull asks SAP only for what changed.
model SapSyncState {
  entity       SapEntity     @id
  lastSyncedAt DateTime?
  lastStatus   SapSyncStatus @default(idle)
  lastMessage  String?
  recordCount  Int           @default(0)
  updatedAt    DateTime      @updatedAt
}

enum SapOutboxKind {
  sales_order
  invoice
}

enum SapOutboxStatus {
  pending
  sent
  failed
}

enum SapOrderSyncStatus {
  pending
  sending
  sent
  failed
  reconciliation_required
}

enum InventoryStatus {
  available
  low
  unavailable
  stale
  unknown
}

/// Outbound queue for things we owe SAP. Orders and invoices are recorded here
/// the moment they happen, so nothing is lost while SAP is unreachable or not
/// yet configured — the drain job retries later.
model SapOutbox {
  id          String          @id @default(uuid())
  kind        SapOutboxKind
  /// Order.id or LedgerEntry.id depending on kind.
  referenceId String
  payload     Json
  status      SapOutboxStatus @default(pending)
  attempts    Int             @default(0)
  lastError   String?
  /// SAP's id once accepted (sales order or invoice number).
  sapId       String?
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@unique([kind, referenceId])
  @@index([status, createdAt])
}

model AppConfig {
  id                            String            @id @default("singleton")
  freeDeliveryThreshold         Decimal           @db.Decimal(12, 2)
  minOrderValue                 Decimal           @db.Decimal(12, 2)
  supportPhone                  String
  creditRolloutMode             CreditRolloutMode @default(shadow)
  creditPolicyApprovedAt        DateTime?
  creditPolicyApprovedByStaffId String?
  creditPolicyApprovedVersion   Int?
  /// Attendance policy. When on, clock-in and clock-out require an attendance
  /// photo. The photo is stored as evidence only — no biometric matching or
  /// facial recognition is performed on it.
  attendanceSelfieRequired      Boolean           @default(false)
  /// Movement tracking policy. When off, the app records no location pings at
  /// all and the tracking banner tells the salesperson so.
  locationTrackingEnabled       Boolean           @default(true)
  /// Sampling interval the app should use while a workday is open. Larger
  /// values trade route resolution for battery.
  locationPingIntervalSeconds   Int               @default(300)
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  category           String
  imageUrl           String?
  description        String?
  sapMaterialId      String?
  variants           Variant[]
  inventorySnapshots InventorySnapshot[]
  createdAt          DateTime            @default(now())
}

// A variant is one sellable case: `unitSize` x `unitsPerCase` (e.g. "1 kg" x 30).
// PriceList.price is the price of the whole case.
model Variant {
  id                 String              @id @default(uuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  unitSize           String
  unit               String
  unitsPerCase       Int                 @default(1)
  // Numeric weight of a single unit. Needed to invoice off delivered weight
  // (spec §5.6): price/kg = casePrice / (unitWeightKg * unitsPerCase).
  unitWeightKg       Decimal             @default(1) @db.Decimal(10, 3)
  priceList          PriceList[]
  orderItems         OrderItem[]
  priceOverrides     PriceOverride[]
  inventorySnapshots InventorySnapshot[]
}

model InventorySnapshot {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       Variant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sapMaterialId String
  warehouseCode String
  onHand        Decimal         @db.Decimal(14, 3)
  committed     Decimal         @default(0) @db.Decimal(14, 3)
  available     Decimal         @db.Decimal(14, 3)
  status        InventoryStatus @default(unknown)
  source        String          @default("sap")
  syncedAt      DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([sapMaterialId, warehouseCode])
  @@index([productId, warehouseCode])
  @@index([status, syncedAt])
}

model PriceList {
  id        String  @id @default(uuid())
  tierId    String
  tier      Tier    @relation(fields: [tierId], references: [id])
  productId String
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  price     Decimal @db.Decimal(12, 2)

  @@unique([tierId, variantId])
}

model PriceOverride {
  id         String   @id @default(uuid())
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id])
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id])
  price      Decimal  @db.Decimal(12, 2)

  @@unique([retailerId, variantId])
}

model Order {
  id                        String                     @id @default(uuid())
  // Human-facing reference shown to retailers (rendered as GGN-00000001).
  orderNo                   Int                        @unique @default(autoincrement())
  retailerId                String
  retailer                  Retailer                   @relation(fields: [retailerId], references: [id])
  idempotencyKey            String?
  placedBy                  PlacedBy                   @default(retailer)
  placedByRepId             String?
  status                    OrderStatus                @default(placed)
  orderTotal                Decimal                    @db.Decimal(12, 2)
  expectedDeliveryAt        DateTime?
  sapSalesOrderId           String?
  sapDocEntry               Int?
  sapDocNum                 Int?
  sapExternalReference      String?                    @unique
  sapSyncStatus             SapOrderSyncStatus         @default(pending)
  sapLastSyncedAt           DateTime?
  sapErrorCode              String?
  sapErrorMessage           String?
  items                     OrderItem[]
  delivery                  Delivery?
  invoice                   Invoice?
  ledgerEntries             LedgerEntry[]
  creditAssessments         CreditAssessment[]
  approvalRequests          ApprovalRequest[]
  dispatchAuthorizations    DispatchAuthorization[]
  creditDecisionComparisons CreditDecisionComparison[]
  customerActivities        CustomerActivity[]
  serviceIssues             ServiceIssue[]
  createdAt                 DateTime                   @default(now())

  @@unique([retailerId, idempotencyKey])
  @@index([sapSyncStatus, createdAt])
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  variantId       String
  variant         Variant       @relation(fields: [variantId], references: [id])
  qtyOrdered      Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  qtyDelivered    Int?
  weightDelivered Decimal?      @db.Decimal(12, 3)
  invoiceLines    InvoiceLine[]
}

model Delivery {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  routeId       String?
  deliverySlot  DateTime?
  podType       PodType?
  podCapturedAt DateTime?
  actualWeight  Decimal?  @db.Decimal(12, 3)
}

model LedgerEntry {
  id               String     @id @default(uuid())
  retailerId       String
  retailer         Retailer   @relation(fields: [retailerId], references: [id])
  orderId          String?
  order            Order?     @relation(fields: [orderId], references: [id])
  paymentId        String?
  payment          Payment?   @relation(fields: [paymentId], references: [id])
  type             LedgerType
  amount           Decimal    @db.Decimal(12, 2)
  balanceAfter     Decimal    @db.Decimal(12, 2)
  // Invoices only: when payment falls due, and how much of it has been settled
  // by payments so far. An invoice is overdue when dueDate has passed and
  // settledAmount is still short of amount.
  dueDate          DateTime?
  settledAmount    Decimal    @default(0) @db.Decimal(12, 2)
  financialInvoice Invoice?
  createdAt        DateTime   @default(now())

  @@index([retailerId, type, dueDate])
}

model Invoice {
  id                  String                @id @default(uuid())
  invoiceNumber       Int                   @unique @default(autoincrement())
  retailerId          String
  retailer            Retailer              @relation(fields: [retailerId], references: [id])
  orderId             String?               @unique
  order               Order?                @relation(fields: [orderId], references: [id])
  legacyLedgerEntryId String?               @unique
  legacyLedgerEntry   LedgerEntry?          @relation(fields: [legacyLedgerEntryId], references: [id], onDelete: Restrict)
  invoiceDate         DateTime
  dueDate             DateTime
  currency            String                @default("INR")
  subtotal            Decimal               @db.Decimal(14, 2)
  taxTotal            Decimal               @default(0) @db.Decimal(14, 2)
  total               Decimal               @db.Decimal(14, 2)
  outstandingAmount   Decimal               @db.Decimal(14, 2)
  status              InvoiceStatus         @default(open)
  idempotencyKey      String                @unique
  sapInvoiceId        String?               @unique
  lines               InvoiceLine[]
  allocations         PaymentAllocation[]
  ledgerEntry         FinancialLedgerEntry?
  creditNotes         CreditNote[]
  recoveryCase        RecoveryCase?
  serviceIssues       ServiceIssue[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([retailerId, status, dueDate])
}

/// One operational recovery timeline per overdue invoice. Actions are immutable
/// schedule keys so rerunning the worker cannot duplicate calls or escalations.
model RecoveryCase {
  id         String             @id @default(uuid())
  invoiceId  String             @unique
  invoice    Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  retailerId String
  retailer   Retailer           @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  status     RecoveryCaseStatus @default(open)
  openedAt   DateTime           @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?
  actions    RecoveryAction[]
  calls      CallLog[]
  promises   PromiseToPay[]
  letters    RecoveryLetter[]
  legalCase  LegalCase?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status, updatedAt])
  @@index([retailerId, status])
}

model RecoveryAction {
  id                 String               @id @default(uuid())
  caseId             String
  recoveryCase       RecoveryCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type               RecoveryActionType
  status             RecoveryActionStatus @default(pending)
  dueAt              DateTime
  role               String
  assigneeStaffId    String?
  idempotencyKey     String               @unique
  details            Json?
  completedAt        DateTime?
  completedByStaffId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, dueAt])
  @@index([caseId, type])
}

model CallLog {
  id             String              @id @default(uuid())
  caseId         String
  recoveryCase   RecoveryCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorStaffId   String
  outcome        RecoveryCallOutcome
  notes          String
  occurredAt     DateTime            @default(now())
  nextActionAt   DateTime?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())

  @@index([caseId, occurredAt])
  @@index([actorStaffId, occurredAt])
}

model PromiseToPay {
  id               String             @id @default(uuid())
  caseId           String
  recoveryCase     RecoveryCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount           Decimal            @db.Decimal(14, 2)
  promisedAt       DateTime           @default(now())
  dueAt            DateTime
  status           PromiseToPayStatus @default(promised)
  createdByStaffId String
  idempotencyKey   String             @unique
  keptAt           DateTime?
  missedAt         DateTime?
  supersededAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([caseId, status, dueAt])
  @@index([status, dueAt])
}

model RecoveryLetter {
  id             String                   @id @default(uuid())
  caseId         String
  recoveryCase   RecoveryCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  objectKey      String                   @unique
  checksum       String
  contentType    String                   @default("application/pdf")
  sizeBytes      Int
  invoiceNumber  Int
  amount         Decimal                  @db.Decimal(14, 2)
  currency       String
  sentAt         DateTime
  responseDueAt  DateTime
  signatories    Json
  idempotencyKey String                   @unique
  deliveries     RecoveryLetterDelivery[]
  legalCase      LegalCase?
  createdAt      DateTime                 @default(now())

  @@index([caseId, sentAt])
}

model RecoveryLetterDelivery {
  id                String                        @id @default(uuid())
  letterId          String
  letter            RecoveryLetter                @relation(fields: [letterId], references: [id], onDelete: Cascade)
  channel           RecoveryLetterDeliveryChannel
  deliveredAt       DateTime                      @default(now())
  actorStaffId      String
  externalReference String?
  idempotencyKey    String                        @unique
  createdAt         DateTime                      @default(now())

  @@index([letterId, deliveredAt])
}

model LegalCase {
  id               String          @id @default(uuid())
  recoveryCaseId   String          @unique
  recoveryCase     RecoveryCase    @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  letterId         String          @unique
  letter           RecoveryLetter  @relation(fields: [letterId], references: [id], onDelete: Restrict)
  status           LegalCaseStatus @default(open)
  reason           String
  openedAt         DateTime        @default(now())
  createdByStaffId String
  idempotencyKey   String          @unique
  decision         LegalDecision?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, openedAt])
}

model LegalDecision {
  id               String            @id @default(uuid())
  legalCaseId      String            @unique
  legalCase        LegalCase         @relation(fields: [legalCaseId], references: [id], onDelete: Cascade)
  type             LegalDecisionType
  amount           Decimal           @db.Decimal(14, 2)
  reason           String
  decidedByStaffId String
  decidedAt        DateTime          @default(now())
  idempotencyKey   String            @unique
  createdAt        DateTime          @default(now())
}

model InvoiceLine {
  id                  String     @id @default(uuid())
  invoiceId           String
  invoice             Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderItemId         String?
  orderItem           OrderItem? @relation(fields: [orderItemId], references: [id])
  descriptionSnapshot String
  itemCodeSnapshot    String?
  deliveredCases      Int?
  deliveredWeightKg   Decimal?   @db.Decimal(14, 3)
  unitPrice           Decimal    @db.Decimal(14, 2)
  lineTotal           Decimal    @db.Decimal(14, 2)
  createdAt           DateTime   @default(now())

  @@unique([invoiceId, orderItemId])
}

model PaymentAllocation {
  id        String                      @id @default(uuid())
  paymentId String
  payment   Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice                     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal                     @db.Decimal(14, 2)
  reversals PaymentReversalAllocation[]
  createdAt DateTime                    @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId, createdAt])
}

model FinancialLedgerEntry {
  id                String              @id @default(uuid())
  sequence          BigInt              @unique @default(autoincrement())
  retailerId        String
  retailer          Retailer            @relation(fields: [retailerId], references: [id])
  invoiceId         String?             @unique
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId         String?             @unique
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNoteId      String?             @unique
  creditNote        CreditNote?         @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  paymentReversalId String?             @unique
  paymentReversal   PaymentReversal?    @relation(fields: [paymentReversalId], references: [id], onDelete: Restrict)
  direction         FinancialDirection
  kind              FinancialLedgerKind
  amount            Decimal             @db.Decimal(14, 2)
  balanceAfter      Decimal             @db.Decimal(14, 2)
  idempotencyKey    String              @unique
  occurredAt        DateTime
  metadata          Json?
  createdAt         DateTime            @default(now())

  @@index([retailerId, sequence])
}

model PaymentEvidence {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  objectKey   String   @unique
  checksum    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([paymentId, createdAt])
}

/// A field-collected payment remains outside the financial ledger until Accounts
/// verifies the evidence and confirms it. Collectors never create Payment rows.
model CollectionSubmission {
  id                 String                     @id @default(uuid())
  retailerId         String
  retailer           Retailer                   @relation(fields: [retailerId], references: [id])
  collectorStaffId   String
  amount             Decimal                    @db.Decimal(12, 2)
  method             CollectionMethod
  reference          String?
  notes              String?
  idempotencyKey     String                     @unique
  status             CollectionSubmissionStatus @default(pending)
  rejectionReason    String?
  paymentId          String?                    @unique
  payment            Payment?                   @relation(fields: [paymentId], references: [id])
  confirmedByStaffId String?
  submittedAt        DateTime                   @default(now())
  confirmedAt        DateTime?
  updatedAt          DateTime                   @updatedAt
  evidence           CollectionEvidence[]
  customerActivities CustomerActivity[]

  @@index([status, submittedAt])
  @@index([retailerId, submittedAt])
  @@index([collectorStaffId, submittedAt])
}

model CollectionAssignment {
  id               String    @id @default(uuid())
  collectorStaffId String
  retailerId       String
  retailer         Retailer  @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  active           Boolean   @default(true)
  assignedAt       DateTime  @default(now())
  endedAt          DateTime?

  @@unique([collectorStaffId, retailerId])
  @@index([collectorStaffId, active, assignedAt])
}

model CollectionEvidence {
  id           String               @id @default(uuid())
  submissionId String
  submission   CollectionSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  objectKey    String               @unique
  checksum     String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime             @default(now())

  @@index([submissionId, createdAt])
}

model CreditNote {
  id              String                @id @default(uuid())
  retailerId      String
  retailer        Retailer              @relation(fields: [retailerId], references: [id])
  invoiceId       String
  invoice         Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount          Decimal               @db.Decimal(14, 2)
  reason          String
  status          CreditNoteStatus      @default(issued)
  idempotencyKey  String                @unique
  sapCreditNoteId String?               @unique
  ledgerEntry     FinancialLedgerEntry?
  createdAt       DateTime              @default(now())

  @@index([invoiceId, createdAt])
}

model PaymentReversal {
  id                  String                      @id @default(uuid())
  paymentId           String
  payment             Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount              Decimal                     @db.Decimal(14, 2)
  unallocatedAmount   Decimal                     @default(0) @db.Decimal(14, 2)
  reason              String
  idempotencyKey      String                      @unique
  allocationReversals PaymentReversalAllocation[]
  ledgerEntry         FinancialLedgerEntry?
  createdAt           DateTime                    @default(now())

  @@index([paymentId, createdAt])
}

model PaymentReversalAllocation {
  id                  String            @id @default(uuid())
  paymentReversalId   String
  paymentReversal     PaymentReversal   @relation(fields: [paymentReversalId], references: [id], onDelete: Restrict)
  paymentAllocationId String
  paymentAllocation   PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)
  amount              Decimal           @db.Decimal(14, 2)
  createdAt           DateTime          @default(now())

  @@unique([paymentReversalId, paymentAllocationId])
  @@index([paymentAllocationId, createdAt])
}

model ReconciliationIssue {
  id             String                    @id @default(uuid())
  retailerId     String?
  retailer       Retailer?                 @relation(fields: [retailerId], references: [id])
  kind           String
  referenceType  String
  referenceId    String
  expectedAmount Decimal?                  @db.Decimal(14, 2)
  actualAmount   Decimal?                  @db.Decimal(14, 2)
  status         ReconciliationIssueStatus @default(open)
  ownerRole      String                    @default("accounts")
  details        Json?
  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?

  @@unique([kind, referenceType, referenceId])
  @@index([status, createdAt])
}

model CreditPolicyVersion {
  id                String             @id @default(uuid())
  version           Int                @unique
  name              String
  active            Boolean            @default(false)
  rules             Json
  reasonCatalog     Json
  approvedByStaffId String?
  approvedAt        DateTime?
  assessments       CreditAssessment[]
  ratingProposals   RatingProposal[]
  createdAt         DateTime           @default(now())

  @@index([active])
}

model CreditProfile {
  id                   String           @id @default(uuid())
  retailerId           String           @unique
  retailer             Retailer         @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  rating               CreditRating     @default(N)
  billingPattern       BillingPattern   @default(unknown)
  accountCreatedAt     DateTime         @default(now())
  kycVerifiedAt        DateTime?
  kycVerifiedByStaffId String?
  kycEvidence          Json?
  ratingConfirmedAt    DateTime?
  nextReviewAt         DateTime?
  cleanInvoiceCount    Int              @default(0)
  advancePaymentOnly   Boolean          @default(false)
  lockedAt             DateTime?
  lockReason           String?
  ratingHistory        RatingHistory[]
  ratingProposals      RatingProposal[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model RatingProposal {
  id                 String               @id @default(uuid())
  creditProfileId    String
  creditProfile      CreditProfile        @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  policyVersionId    String
  policyVersion      CreditPolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  previousRating     CreditRating
  proposedRating     CreditRating
  trigger            String
  evidence           Json
  status             RatingProposalStatus @default(pending)
  idempotencyKey     String               @unique
  proposedAt         DateTime             @default(now())
  confirmedByStaffId String?
  confirmedAt        DateTime?
  dismissedByStaffId String?
  dismissedAt        DateTime?

  @@index([status, proposedAt])
  @@index([creditProfileId, proposedAt])
}

model RatingHistory {
  id                 String         @id @default(uuid())
  sequence           BigInt         @unique @default(autoincrement())
  creditProfileId    String
  creditProfile      CreditProfile  @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  fromRating         CreditRating?
  toRating           CreditRating
  billingPattern     BillingPattern
  reason             String
  evidence           Json
  confirmedByStaffId String
  effectiveAt        DateTime
  createdAt          DateTime       @default(now())

  @@index([creditProfileId, sequence])
}

model CreditAssessment {
  id                     String                    @id @default(uuid())
  retailerId             String
  retailer               Retailer                  @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId                String?
  order                  Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  policyVersionId        String
  policyVersion          CreditPolicyVersion       @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  result                 CreditAssessmentResult
  requiredPermission     String?
  projectedExposure      Decimal                   @db.Decimal(14, 2)
  snapshot               Json
  reasons                Json
  approvalRequests       ApprovalRequest[]
  dispatchAuthorizations DispatchAuthorization[]
  comparison             CreditDecisionComparison?
  createdAt              DateTime                  @default(now())

  @@index([retailerId, createdAt])
  @@index([orderId, createdAt])
}

model CreditDecisionComparison {
  id                    String                 @id @default(uuid())
  retailerId            String
  retailer              Retailer               @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId               String?
  order                 Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assessmentId          String                 @unique
  assessment            CreditAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  rolloutMode           CreditRolloutMode
  legacyResult          String
  engineResult          CreditAssessmentResult
  effectiveResult       String
  mismatch              Boolean
  creditTeamDisposition String?
  createdAt             DateTime               @default(now())

  @@index([mismatch, createdAt])
  @@index([retailerId, createdAt])
}

model ApprovalRequest {
  id                     String                  @id @default(uuid())
  retailerId             String
  retailer               Retailer                @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  orderId                String?
  order                  Order?                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assessmentId           String
  assessment             CreditAssessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  subjectType            String
  subjectId              String
  approvalType           String
  requiredPermission     String
  status                 ApprovalStatus          @default(open)
  requestedByStaffId     String?
  requestReason          String?
  deadlineAt             DateTime?
  acknowledgedAt         DateTime?
  decidedAt              DateTime?
  escalatedAt            DateTime?
  decision               ApprovalDecision?
  escalations            ApprovalEscalation[]
  disputes               ApprovalDispute[]
  dispatchAuthorizations DispatchAuthorization[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([requiredPermission, status, createdAt])
  @@index([retailerId, createdAt])
}

model ApprovalDecision {
  id                String                 @id @default(uuid())
  approvalRequestId String                 @unique
  approvalRequest   ApprovalRequest        @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  result            ApprovalDecisionResult
  actorStaffId      String
  reason            String?
  stepUpSessionId   String
  createdAt         DateTime               @default(now())
}

model ApprovalEscalation {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  fromPermission    String
  toPermission      String
  reasonCode        String
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId, createdAt])
}

model ApprovalDispute {
  id                  String                  @id @default(uuid())
  approvalRequestId   String
  approvalRequest     ApprovalRequest         @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  status              ApprovalDisputeStatus   @default(open)
  raisedByStaffId     String
  writtenPosition     String
  counterPosition     String?
  resolvedByStaffId   String?
  resolution          String?
  outcome             ApprovalDecisionResult?
  acknowledgmentDueAt DateTime
  acknowledgedAt      DateTime?
  decisionDueAt       DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, acknowledgmentDueAt])
  @@index([approvalRequestId, createdAt])
}

model DispatchAuthorization {
  id                String                      @id @default(uuid())
  orderId           String
  order             Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version           Int
  assessmentId      String
  assessment        CreditAssessment            @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  approvalRequestId String?
  approvalRequest   ApprovalRequest?            @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  status            DispatchAuthorizationStatus @default(active)
  issuedByStaffId   String?
  reason            String
  expiresAt         DateTime?
  usedAt            DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime                    @default(now())

  @@unique([orderId, version])
  @@index([orderId, status])
}

model WorkingCalendar {
  id           String   @id @default(uuid())
  date         DateTime @unique @db.Date
  isWorkingDay Boolean
  label        String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Field operations — the salesperson's workday.
//
// These entities describe how a salesperson spends a day in the field: when
// the day starts and ends, which stores are planned for it, what happened at
// each store, and what still has to be done. They deliberately reuse the
// existing Retailer / Order / Invoice / SalesVisit / StaffUser entities rather
// than introducing a parallel customer or order model.
// ---------------------------------------------------------------------------

enum WorkdayStatus {
  open
  closed
}

enum LeaveType {
  casual
  sick
  unpaid
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum RoutePlanStatus {
  draft
  published
  completed
  cancelled
}

enum RouteStopStatus {
  pending
  visited
  skipped
}

enum VisitPurpose {
  sales_call
  collection
  service
  onboarding
  merchandising
  other
}

enum VisitOutcome {
  order_placed
  no_order
  payment_collected
  follow_up_required
  issue_raised
  shop_closed
  decision_maker_unavailable
  other
}

/// Controlled vocabulary for what a salesperson did at a store. Free text
/// lives in `notes`; the type is what dashboards and manager reporting read.
enum CustomerActivityType {
  order_discussion
  order_placed
  payment_discussion
  collection_completed
  product_demo
  stock_check
  merchandising
  complaint_raised
  follow_up_required
  competitor_observation
  no_order
  shop_closed
  decision_maker_unavailable
  note
}

enum FieldTaskPriority {
  low
  normal
  high
  urgent
}

enum FieldTaskStatus {
  open
  in_progress
  done
  cancelled
}

enum ExpenseCategory {
  travel
  fuel
  food
  lodging
  telephone
  other
}

enum ExpenseStatus {
  submitted
  approved
  rejected
}

enum ServiceIssueType {
  damaged_product
  delivery_issue
  invoice_issue
  payment_issue
  quality_complaint
  service_request
  other
}

enum ServiceIssuePriority {
  low
  normal
  high
  urgent
}

enum ServiceIssueStatus {
  open
  in_progress
  resolved
  closed
  rejected
}

enum SalesTargetMetric {
  /// Value of orders the salesperson placed, excluding rejected orders.
  order_value
  visits
  collection_value
  new_customers
  /// Number of orders placed, regardless of value.
  order_count
  /// Total order lines placed — the breadth measure behind range selling.
  line_items
  /// Distinct stores where a visit produced an order or a collection.
  productive_outlets
}

/// One salesperson's working day. Its `open` state is the only thing that
/// authorises movement tracking, so nothing is recorded before clock-in or
/// after clock-out.
model WorkdaySession {
  id                  String         @id @default(uuid())
  salespersonId       String
  salesperson         StaffUser      @relation("SalespersonWorkdays", fields: [salespersonId], references: [id], onDelete: Restrict)
  /// Calendar day the session belongs to, in the deployment's local timezone.
  workDate            DateTime       @db.Date
  status              WorkdayStatus  @default(open)
  startedAt           DateTime       @default(now())
  startLatitude       Decimal        @db.Decimal(10, 7)
  startLongitude      Decimal        @db.Decimal(10, 7)
  startAccuracyMeters Decimal        @db.Decimal(8, 2)
  /// Optional attendance photo, stored through the platform object storage.
  /// Only required when AppConfig.attendanceSelfieRequired is on. No facial
  /// recognition is performed on it anywhere in this system.
  startPhotoObjectKey String?
  endedAt             DateTime?
  endLatitude         Decimal?       @db.Decimal(10, 7)
  endLongitude        Decimal?       @db.Decimal(10, 7)
  endAccuracyMeters   Decimal?       @db.Decimal(8, 2)
  endPhotoObjectKey   String?
  devicePlatform      String?
  /// Denormalised working minutes, written once at clock-out.
  workedMinutes       Int?
  locationPings       LocationPing[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([salespersonId, workDate])
  @@index([workDate, status])
}

model LeaveRequest {
  id               String      @id @default(uuid())
  salespersonId    String
  salesperson      StaffUser   @relation("SalespersonLeave", fields: [salespersonId], references: [id], onDelete: Restrict)
  fromDate         DateTime    @db.Date
  toDate           DateTime    @db.Date
  type             LeaveType   @default(casual)
  reason           String
  status           LeaveStatus @default(pending)
  decidedByStaffId String?
  decidedBy        StaffUser?  @relation("LeaveDecisions", fields: [decidedByStaffId], references: [id], onDelete: Restrict)
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([salespersonId, fromDate])
  @@index([status, fromDate])
}

/// The stores a salesperson is expected to cover on one date, in order.
/// Assignment of a retailer to a salesperson still lives on Retailer.salesRepId;
/// a route plan only schedules already-assigned retailers.
model RoutePlan {
  id               String          @id @default(uuid())
  salespersonId    String
  salesperson      StaffUser       @relation("SalespersonRoutePlans", fields: [salespersonId], references: [id], onDelete: Restrict)
  planDate         DateTime        @db.Date
  name             String?
  status           RoutePlanStatus @default(draft)
  createdByStaffId String?
  publishedAt      DateTime?
  completedAt      DateTime?
  stops            RoutePlanStop[]
  tasks            FieldTask[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([salespersonId, planDate])
  @@index([planDate, status])
}

model RoutePlanStop {
  id          String          @id @default(uuid())
  routePlanId String
  routePlan   RoutePlan       @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  retailerId  String
  retailer    Retailer        @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  sequence    Int
  status      RouteStopStatus @default(pending)
  purpose     VisitPurpose    @default(sales_call)
  note        String?
  skipReason  String?
  visitedAt   DateTime?
  visits      SalesVisit[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([routePlanId, retailerId])
  @@index([routePlanId, sequence])
  @@index([retailerId, createdAt])
}

/// A structured record of something that happened with a customer. Written
/// from the field, usually inside a visit; projected into customer history,
/// the salesperson dashboard and manager reporting.
model CustomerActivity {
  id              String                @id @default(uuid())
  retailerId      String
  retailer        Retailer              @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  salespersonId   String
  salesperson     StaffUser             @relation("SalespersonActivities", fields: [salespersonId], references: [id], onDelete: Restrict)
  visitId         String?
  visit           SalesVisit?           @relation(fields: [visitId], references: [id], onDelete: SetNull)
  type            CustomerActivityType
  notes           String?
  followUpAt      DateTime?
  orderId         String?
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  collectionId    String?
  collection      CollectionSubmission? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  serviceIssueId  String?
  serviceIssue    ServiceIssue?         @relation(fields: [serviceIssueId], references: [id], onDelete: SetNull)
  occurredAt      DateTime              @default(now())
  /// Client-generated id that makes offline replay idempotent.
  clientReference String?
  createdAt       DateTime              @default(now())

  @@unique([salespersonId, clientReference])
  @@index([retailerId, occurredAt])
  @@index([salespersonId, occurredAt])
  @@index([type, occurredAt])
}

model FieldTask {
  id                String            @id @default(uuid())
  assignedToStaffId String
  assignedTo        StaffUser         @relation("FieldTasksAssigned", fields: [assignedToStaffId], references: [id], onDelete: Restrict)
  createdByStaffId  String?
  createdBy         StaffUser?        @relation("FieldTasksCreated", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  retailerId        String?
  retailer          Retailer?         @relation(fields: [retailerId], references: [id], onDelete: SetNull)
  routePlanId       String?
  routePlan         RoutePlan?        @relation(fields: [routePlanId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  priority          FieldTaskPriority @default(normal)
  status            FieldTaskStatus   @default(open)
  dueAt             DateTime?
  completedAt       DateTime?
  completionNote    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([assignedToStaffId, status, dueAt])
  @@index([retailerId, status])
}

/// One recorded position during an open workday. Rows are only accepted while
/// the referenced WorkdaySession is open, which is what keeps tracking inside
/// working hours.
model LocationPing {
  id               String         @id @default(uuid())
  workdaySessionId String
  workdaySession   WorkdaySession @relation(fields: [workdaySessionId], references: [id], onDelete: Cascade)
  salespersonId    String
  salesperson      StaffUser      @relation("SalespersonPings", fields: [salespersonId], references: [id], onDelete: Restrict)
  recordedAt       DateTime
  latitude         Decimal        @db.Decimal(10, 7)
  longitude        Decimal        @db.Decimal(10, 7)
  accuracyMeters   Decimal        @db.Decimal(8, 2)
  speedMps         Decimal?       @db.Decimal(8, 2)
  headingDegrees   Decimal?       @db.Decimal(6, 2)
  batteryPct       Int?
  /// Client-generated id so a retried offline batch cannot duplicate rows.
  clientReference  String
  createdAt        DateTime       @default(now())

  @@unique([salespersonId, clientReference])
  @@index([workdaySessionId, recordedAt])
  @@index([salespersonId, recordedAt])
}

model FieldExpense {
  id                 String          @id @default(uuid())
  salespersonId      String
  salesperson        StaffUser       @relation("SalespersonExpenses", fields: [salespersonId], references: [id], onDelete: Restrict)
  expenseDate        DateTime        @db.Date
  category           ExpenseCategory
  amount             Decimal         @db.Decimal(12, 2)
  description        String
  receiptObjectKey   String?
  receiptContentType String?
  status             ExpenseStatus   @default(submitted)
  submittedAt        DateTime        @default(now())
  decidedByStaffId   String?
  decidedBy          StaffUser?      @relation("ExpenseDecisions", fields: [decidedByStaffId], references: [id], onDelete: Restrict)
  decidedAt          DateTime?
  decisionNote       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([salespersonId, expenseDate])
  @@index([status, submittedAt])
}

model ServiceIssue {
  id              String               @id @default(uuid())
  retailerId      String
  retailer        Retailer             @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  raisedByStaffId String
  raisedBy        StaffUser            @relation("ServiceIssuesRaised", fields: [raisedByStaffId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  visitId         String?
  visit           SalesVisit?          @relation(fields: [visitId], references: [id], onDelete: SetNull)
  type            ServiceIssueType
  priority        ServiceIssuePriority @default(normal)
  description     String
  status          ServiceIssueStatus   @default(open)
  assignedTeam    String?
  resolutionNote  String?
  resolvedAt      DateTime?
  activities      CustomerActivity[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([retailerId, createdAt])
  @@index([status, priority, createdAt])
  @@index([raisedByStaffId, createdAt])
}

/// A target set for one salesperson over one period. Target-versus-achievement
/// is only reported when a row exists; no target is ever invented.
model SalesTarget {
  id               String            @id @default(uuid())
  salespersonId    String
  salesperson      StaffUser         @relation("SalespersonTargets", fields: [salespersonId], references: [id], onDelete: Restrict)
  metric           SalesTargetMetric
  periodStart      DateTime          @db.Date
  periodEnd        DateTime          @db.Date
  targetValue      Decimal           @db.Decimal(14, 2)
  createdByStaffId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([salespersonId, metric, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
}

// ---------------------------------------------------------------------------
// Performance, recognition and field intelligence.
//
// Ranking, run-rate projection and next-best-action triggers are all computed
// read models over the rows that already exist — none of them are stored. Only
// two things here need persistence: an achievement, because it must fire once
// and stay earned, and a retailer proposal, because it is a governance record.
// ---------------------------------------------------------------------------

enum AchievementType {
  TARGET_50
  TARGET_75
  TARGET_90
  TARGET_100
  TARGET_EXCEEDED
  PERSONAL_BEST
  COLLECTION_TARGET
  NEW_RETAILER_MILESTONE
  RANK_UP
  TOP_10
  TOP_3
}

enum AchievementSubjectKind {
  salesperson
  retailer
}

/// A recognition event that has been earned. Recognition only — this system
/// carries no reward, discount or payout, and nothing reads it as if it did.
model AchievementEvent {
  id          String                 @id @default(uuid())
  subjectKind AchievementSubjectKind @default(salesperson)
  /// StaffUser id for a salesperson subject, Retailer id for a retailer one.
  subjectId   String
  type        AchievementType
  /// SalesTargetMetric name, or another canonical measure the event is about.
  metric      String?
  /// Period the event belongs to, so the same milestone can be earned again
  /// next month without ever firing twice inside one period.
  periodStart DateTime               @db.Date
  periodEnd   DateTime               @db.Date
  /// The level that was crossed, in the metric's own unit.
  threshold   Decimal?               @db.Decimal(14, 2)
  /// The measured value at the moment it was earned.
  actual      Decimal?               @db.Decimal(14, 2)
  title       String
  message     String
  earnedAt    DateTime               @default(now())
  /// When this stops being worth showing. Null means it does not expire.
  expiresAt   DateTime?
  /// Whatever the engine measured, kept so the event stays explainable later.
  evidence    Json?
  /// The engine's own identity for this event — type, metric, period and level.
  /// A composite unique over nullable columns would let Postgres treat two
  /// null-metric events as distinct and fire the same milestone twice, so the
  /// key is computed as one total string instead.
  dedupeKey   String
  createdAt   DateTime               @default(now())

  @@unique([subjectKind, subjectId, dedupeKey])
  @@index([subjectKind, subjectId, earnedAt])
  @@index([type, earnedAt])
}

enum RetailerProposalStatus {
  pending
  approved
  rejected
  withdrawn
}

/// A salesperson's request to add a store to the customer master.
///
/// This is a governance record, not a second customer model: approving it
/// creates one canonical `Retailer` and links back to it. Nothing reads a
/// proposal as if it were a customer.
model RetailerProposal {
  id                 String                 @id @default(uuid())
  status             RetailerProposalStatus @default(pending)
  businessName       String
  ownerName          String?
  phone              String
  shopAddress        String
  /// Captured at the storefront where the device could provide it.
  latitude           Decimal?               @db.Decimal(10, 7)
  longitude          Decimal?               @db.Decimal(10, 7)
  accuracyMeters     Decimal?               @db.Decimal(8, 2)
  /// Proposed classification. The reviewer decides the tier that is applied.
  proposedTierId     String?
  proposedTier       Tier?                  @relation(fields: [proposedTierId], references: [id], onDelete: SetNull)
  notes              String?
  submittedByStaffId String
  submittedBy        StaffUser              @relation("RetailerProposalsSubmitted", fields: [submittedByStaffId], references: [id], onDelete: Restrict)
  submittedAt        DateTime               @default(now())
  reviewedByStaffId  String?
  reviewedBy         StaffUser?             @relation("RetailerProposalsReviewed", fields: [reviewedByStaffId], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?
  rejectionReason    String?
  /// Set when approval created the customer.
  retailerId         String?                @unique
  retailer           Retailer?              @relation(fields: [retailerId], references: [id], onDelete: SetNull)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, submittedAt])
  @@index([submittedByStaffId, submittedAt])
}
